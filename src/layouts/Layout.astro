---
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  footerCta?: boolean;
}

const {
  title = "Proingenio · Oficina técnica de ingeniería en Ibiza",
  description = "Oficina técnica de ingeniería en Santa Eulària des Riu, Ibiza. Proyectos de instalaciones interiores, infraestructuras y actividades, y asesoramiento a instaladores.",
  noindex = false,
  footerCta = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <!-- Marca que hay JS para activar las animaciones de aparición (sin JS todo se ve) -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="min-h-screen">
    <a href="#contenido" class="label sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-ink focus:px-4 focus:py-3 focus:text-white">
      Saltar al contenido
    </a>
    <Navbar />
    <main id="contenido">
      <slot />
    </main>
    <Footer cta={footerCta} />

    <script>
      // Aparición discreta de elementos al entrar en pantalla
      const elementos = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (!("IntersectionObserver" in window)) {
        elementos.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        elementos.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
