---
import { Image } from "astro:assets";
import heroImagen from "@/assets/proyecto.jpg";
import Logo from "@/components/Logo.astro";
import { empresa } from "@/data/site";

const indice = [
  { n: "01", label: "Quiénes somos", href: "#estudio" },
  { n: "02", label: "Departamentos", href: "#departamentos" },
  { n: "03", label: "Contacto", href: "#contacto" },
];
---

<section class="relative overflow-hidden">
  <div class="wrap pt-10 md:pt-16">
    <!-- Metadatos en la línea superior -->
    <div class="label grid-12 gap-y-2 text-ink-mute" data-reveal>
      <p class="col-span-4 md:col-span-3">{empresa.descriptor}</p>
      <p class="col-span-4 md:col-span-3">{empresa.ubicacion}</p>
      <p class="col-span-2 hidden md:col-span-3 md:block">{empresa.coordenadas}</p>
    </div>

    <!-- Titular -->
    <div class="grid-12 mt-10 gap-y-10 md:mt-16">
      <h1 class="display-xl col-span-4 md:col-span-11 lg:col-span-10" data-reveal style="--reveal-delay: 80ms">
        Ingeniería de proyectos, instalaciones y actividades
        <span class="text-ink-mute">en Ibiza.</span>
      </h1>
    </div>

    <div class="grid-12 mt-10 gap-y-8 md:mt-14">
      <p class="lead col-span-4 text-ink-soft md:col-span-6 md:col-start-4 lg:col-span-5 lg:col-start-4" data-reveal style="--reveal-delay: 160ms">
        Redactamos proyectos técnicos, dirigimos obras y tramitamos licencias ante los ayuntamientos de la isla, con un único
        interlocutor de principio a fin.
      </p>
      <div class="col-span-4 flex flex-wrap items-end gap-x-10 gap-y-4 md:col-span-3 md:col-start-10 md:flex-col md:items-start md:justify-end" data-reveal style="--reveal-delay: 240ms">
        <a href="/departamentos" class="arrow-link">Ver departamentos <span class="arrow" aria-hidden="true"></span></a>
        <a href="#contacto" class="arrow-link text-ink-soft hover:text-ink">Solicitar presupuesto <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </div>

  <!-- Fotografía principal -->
  <div class="wrap mt-14 md:mt-20">
    <figure>
      <div class="crop-marks">
        <div class="overflow-hidden" data-reveal="image">
          <Image
            src={heroImagen}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1440px) 1312px, 100vw"
            quality={78}
            loading="eager"
            fetchpriority="high"
            alt="Equipo técnico revisando documentación de un proyecto"
            class="photo aspect-[4/3] w-full object-cover md:aspect-[21/9]"
          />
        </div>
        <!-- Sello corporativo: bloque marino con el logotipo y marco desplazado -->
        <div
          class="absolute left-[5%] top-1/2 z-[3] hidden aspect-square w-[min(28%,21rem)] -translate-y-1/2 md:block"
          data-reveal
          style="--reveal-delay: 500ms"
        >
          <span class="absolute -inset-3 border border-white/70 lg:-inset-4" aria-hidden="true"></span>
          <div class="relative flex h-full w-full flex-col justify-between bg-accent p-6 lg:p-9">
            <span class="label text-accent-soft">{empresa.coordenadas}</span>
            <Logo variante="completo" tono="negativo" class="w-full" />
            <span class="label text-white/60">Santa Eulària des Riu</span>
          </div>
        </div>
      </div>
      <figcaption class="label mt-5 grid-12 gap-y-6 text-ink-mute">
        <span class="col-span-4 md:col-span-3">Fig. 01 — Revisión de proyecto</span>
        <!-- Índice de la página -->
        <nav class="col-span-4 md:col-span-9" aria-label="Índice de la página">
          <ol class="grid grid-cols-2 gap-x-6 gap-y-2 md:grid-cols-3">
            {
              indice.map((i) => (
                <li>
                  <a href={i.href} class="flex gap-3 border-t border-line pt-3 transition-colors hover:border-ink hover:text-ink">
                    <span class="text-accent">{i.n}</span>
                    {i.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </figcaption>
    </figure>
  </div>
</section>
