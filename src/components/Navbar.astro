---
import Logo from "@/components/Logo.astro";
import { navegacion, departamentos, empresa } from "@/data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const activo = (href: string) => href !== "/" && !href.includes("#") && path.startsWith(href);
---

<header id="cabecera" class="sticky top-0 z-50 border-b border-line bg-paper">
  <nav class="wrap flex h-[4.5rem] items-center justify-between gap-6" aria-label="Principal">
    <a href="/" class="shrink-0" aria-label="Proingenio, ir al inicio">
      <Logo variante="marca" class="h-7 w-auto sm:h-8 xl:h-9" />
    </a>

    <!-- Escritorio -->
    <div class="hidden items-center gap-10 lg:flex">
      <ul class="flex items-center gap-9 text-[0.9375rem]">
        {
          navegacion.map((item) =>
            item.submenu ? (
              <li class="group relative">
                <a
                  href={item.href}
                  class:list={["nav-link inline-flex h-[4.5rem] items-center gap-1.5", { "is-active": activo(item.href) }]}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="h-3 w-3 transition-transform duration-300 group-hover:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                    <path d="M2.5 4.5 6 8l3.5-3.5" />
                  </svg>
                </a>
                <!-- Panel desplegable -->
                <div class="invisible absolute left-1/2 top-full w-[34rem] -translate-x-1/2 translate-y-2 border border-line bg-paper opacity-0 shadow-[0_24px_48px_-24px_rgba(18,20,23,0.25)] transition-all duration-300 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                  <ul class="divide-y divide-line">
                    {departamentos.map((d) => (
                      <li>
                        <a href={`/departamentos#${d.id}`} class="group/item grid grid-cols-[3rem_1fr_auto] items-baseline gap-2 px-6 py-4 transition-colors hover:bg-lime">
                          <span class="label text-accent">{d.codigo}</span>
                          <span>
                            <span class="block font-medium">{d.titulo}</span>
                            <span class="mt-1 block text-sm text-ink-mute">{d.resumen}</span>
                          </span>
                          <span class="text-ink-mute transition-transform duration-300 group-hover/item:translate-x-1" aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={["nav-link inline-flex h-[4.5rem] items-center", { "is-active": activo(item.href) }]}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <a href="/#contacto" class="btn btn-primary !py-2.5">Contacto</a>
    </div>

    <!-- Botón menú móvil -->
    <button
      id="menu-toggle"
      type="button"
      class="label -mr-2 flex items-center gap-3 p-2 lg:hidden"
      aria-controls="menu-movil"
      aria-expanded="false"
    >
      <span class="menu-texto">Menú</span>
      <span class="relative block h-3 w-6" aria-hidden="true">
        <span class="bar absolute left-0 top-0 h-px w-full bg-ink transition-transform duration-300"></span>
        <span class="bar absolute bottom-0 left-0 h-px w-full bg-ink transition-transform duration-300"></span>
      </span>
    </button>
  </nav>

  <!-- Menú móvil a pantalla completa -->
  <div
    id="menu-movil"
    class="fixed inset-x-0 bottom-0 top-[4.5rem] hidden overflow-y-auto bg-paper lg:hidden"
  >
    <div class="wrap flex min-h-full flex-col justify-between gap-12 py-10">
      <ul class="divide-y divide-line border-y border-line">
        <li>
          <a href="/#estudio" class="flex items-baseline gap-5 py-5 font-display text-3xl font-semibold tracking-tight">
            <span class="label text-accent">A</span>Quiénes somos
          </a>
        </li>
        <li class="py-5">
          <a href="/departamentos" class="flex items-baseline gap-5 font-display text-3xl font-semibold tracking-tight">
            <span class="label text-accent">B</span>Departamentos
          </a>
          <ul class="mt-4 space-y-1 pl-9">
            {
              departamentos.map((d) => (
                <li>
                  <a href={`/departamentos#${d.id}`} class="flex gap-4 py-1.5 text-ink-soft">
                    <span class="label pt-1 text-ink-mute">{d.codigo}</span>
                    {d.titulo}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li>
          <a href="/proyectos" class="flex items-baseline gap-5 py-5 font-display text-3xl font-semibold tracking-tight">
            <span class="label text-accent">C</span>Proyectos
          </a>
        </li>
        <li>
          <a href="/#contacto" class="flex items-baseline gap-5 py-5 font-display text-3xl font-semibold tracking-tight">
            <span class="label text-accent">D</span>Contacto
          </a>
        </li>
      </ul>
      <div class="label space-y-2 text-ink-mute">
        <p>{empresa.descriptor}</p>
        <p>{empresa.ubicacion}</p>
        <p>{empresa.coordenadas}</p>
        <p><a href={empresa.telefonos[0].href} class="text-ink">{empresa.telefonos[0].numero}</a></p>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    color: var(--color-ink-soft);
    transition: color 200ms ease;
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-ink);
  }
  /* Pestaña marino sobre la línea inferior de la cabecera */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease-out-quint);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  #menu-toggle[aria-expanded="true"] .bar:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }
  #menu-toggle[aria-expanded="true"] .bar:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }
</style>

<script>
  const boton = document.getElementById("menu-toggle");
  const menu = document.getElementById("menu-movil");
  const texto = boton?.querySelector(".menu-texto");

  const setMenu = (abrir: boolean) => {
    boton?.setAttribute("aria-expanded", String(abrir));
    menu?.classList.toggle("hidden", !abrir);
    document.documentElement.style.overflow = abrir ? "hidden" : "";
    if (texto) texto.textContent = abrir ? "Cerrar" : "Menú";
  };

  boton?.addEventListener("click", () => setMenu(boton.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
  // Si se pasa a escritorio con el menú abierto, cerrarlo
  window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && setMenu(false));
</script>
