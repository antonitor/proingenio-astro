---
import { Image } from "astro:assets";
import logo from "@/assets/PROINGENIO.png";

const departamentos = [
  { href: "/departamentos#proyectos-actividades", label: "Proyectos de actividades" },
  { href: "/departamentos#instalaciones-interiores", label: "Proyectos de instalaciones interiores" },
  { href: "/departamentos#infraestructuras", label: "Proyectos de infraestructuras" },
  { href: "/departamentos#asesoramiento", label: "Asesoramiento e instaladores" },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white">
  <nav class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="/" class="shrink-0">
      <Image src={logo} height={80} alt="Proingenio" class="h-10 w-auto" loading="eager" />
    </a>

    <!-- Escritorio -->
    <ul class="hidden items-center gap-6 text-sm font-medium text-slate-700 md:flex">
      <li><a href="/#quienes-somos" class="hover:text-indigo-600">Quienes somos</a></li>
      <li class="group relative">
        <a href="/departamentos" class="inline-flex items-center gap-1 py-5 hover:text-indigo-600">
          Departamentos
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </a>
        <ul class="invisible absolute left-0 top-full w-72 rounded-md border border-slate-200 bg-white py-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          {departamentos.map((d) => (
            <li>
              <a href={d.href} class="block px-4 py-2 hover:bg-slate-100 hover:text-indigo-600">{d.label}</a>
            </li>
          ))}
        </ul>
      </li>
      <li><a href="/#proyectos" class="hover:text-indigo-600">Proyectos destacados</a></li>
      <li>
        <a href="/#contacto" class="rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700">Contacto</a>
      </li>
    </ul>

    <!-- Botón móvil -->
    <button
      id="menu-toggle"
      type="button"
      class="rounded-md p-2 text-slate-700 hover:bg-slate-100 md:hidden"
      aria-controls="menu-movil"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Menú móvil -->
  <div id="menu-movil" class="hidden border-t border-slate-200 bg-white md:hidden">
    <ul class="container mx-auto space-y-1 px-4 py-4 text-slate-700">
      <li><a href="/#quienes-somos" class="block rounded-md px-3 py-2 hover:bg-slate-100">Quienes somos</a></li>
      <li>
        <a href="/departamentos" class="block rounded-md px-3 py-2 hover:bg-slate-100">Departamentos</a>
        <ul class="ml-4 space-y-1 border-l border-slate-200 pl-3 text-sm">
          {departamentos.map((d) => (
            <li><a href={d.href} class="block rounded-md px-3 py-2 hover:bg-slate-100">{d.label}</a></li>
          ))}
        </ul>
      </li>
      <li><a href="/#proyectos" class="block rounded-md px-3 py-2 hover:bg-slate-100">Proyectos destacados</a></li>
      <li><a href="/#contacto" class="block rounded-md px-3 py-2 hover:bg-slate-100">Contacto</a></li>
    </ul>
  </div>
</header>

<script>
  const boton = document.getElementById("menu-toggle");
  const menu = document.getElementById("menu-movil");

  boton?.addEventListener("click", () => {
    const abierto = boton.getAttribute("aria-expanded") === "true";
    boton.setAttribute("aria-expanded", String(!abierto));
    menu?.classList.toggle("hidden", abierto);
  });

  // Cerrar el menú al pulsar un enlace (útil para anclas dentro de la misma página)
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      boton?.setAttribute("aria-expanded", "false");
    })
  );
</script>
