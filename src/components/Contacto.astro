---
import SectionHeader from "@/components/SectionHeader.astro";
import { empresa, departamentos } from "@/data/site";
---

<section id="contacto" class="bg-paper py-24 md:py-36">
  <div class="wrap">
    <SectionHeader
      numero="03"
      etiqueta="Contacto"
      titulo="Cuéntanos tu proyecto."
      intro="Solicita información o presupuesto sin compromiso. Respondemos personalmente cada consulta."
    />

    <div class="grid-12 mt-16 gap-y-16 md:mt-24">
      <!-- Datos de contacto -->
      <dl class="col-span-4 self-start border-b border-line text-[0.9375rem] md:col-span-5 lg:col-span-4" data-reveal>
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-t border-line py-5">
          <dt class="label pt-0.5 text-ink-mute">Teléfono</dt>
          <dd class="space-y-1.5">
            {
              empresa.telefonos.map((t) => (
                <p>
                  <a href={t.href} class="font-medium hover:text-accent">{t.numero}</a>
                  <span class="text-ink-mute"> · {t.label}</span>
                </p>
              ))
            }
          </dd>
        </div>
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-t border-line py-5">
          <dt class="label pt-0.5 text-ink-mute">Email</dt>
          <dd class="space-y-1.5">
            {
              empresa.emails.map((e) => (
                <p>
                  <a href={`mailto:${e}`} class="break-all font-medium hover:text-accent">{e}</a>
                </p>
              ))
            }
          </dd>
        </div>
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-t border-line py-5">
          <dt class="label pt-0.5 text-ink-mute">Oficina</dt>
          <dd>
            <address class="not-italic">
              {empresa.direccion.map((l) => <span class="block">{l}</span>)}
            </address>
          </dd>
        </div>
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-t border-line py-5">
          <dt class="label pt-0.5 text-ink-mute">Horario</dt>
          <dd>{empresa.horario}</dd>
        </div>
      </dl>

      <!-- Formulario (Netlify Forms) -->
      <form
        name="contacto"
        method="POST"
        action="/gracias"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="crop-marks col-span-4 self-start border border-line p-6 md:col-span-7 md:col-start-6 md:p-10 lg:col-start-6"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <!-- Campo trampa antispam: invisible para personas -->
        <p class="hidden" aria-hidden="true">
          <label>No rellenar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <p class="label -mx-6 -mt-6 mb-8 flex justify-between border-b border-line px-6 py-4 text-ink-mute md:-mx-10 md:-mt-10 md:px-10">
          <span>Formulario de consulta</span>
          <span class="text-accent">F-01</span>
        </p>

        <div class="grid gap-x-8 gap-y-7 md:grid-cols-2">
          <div>
            <label for="nombre" class="label text-ink-mute">Nombre completo *</label>
            <input type="text" id="nombre" name="nombre" required autocomplete="name" class="field" />
          </div>
          <div>
            <label for="email" class="label text-ink-mute">Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="field" />
          </div>
          <div>
            <label for="telefono" class="label text-ink-mute">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" autocomplete="tel" class="field" />
          </div>
          <div>
            <label for="area" class="label text-ink-mute">Área</label>
            <select id="area" name="area" class="field cursor-pointer">
              <option value="">Sin especificar</option>
              {departamentos.map((d) => <option value={d.titulo}>{d.titulo}</option>)}
            </select>
          </div>
          <div class="md:col-span-2">
            <label for="mensaje" class="label text-ink-mute">Mensaje *</label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              rows="4"
              class="field resize-y"
              placeholder="Tipo de proyecto, ubicación, plazos…"></textarea>
          </div>
        </div>

        <div class="mt-8 flex items-start gap-3">
          <input
            type="checkbox"
            id="privacidad"
            name="privacidad"
            required
            class="mt-0.5 h-4 w-4 shrink-0 cursor-pointer rounded-none accent-[var(--color-accent)]"
          />
          <label for="privacidad" class="text-sm text-ink-soft">
            He leído y acepto la <a href="/privacidad" class="underline underline-offset-2 hover:text-accent">política de privacidad</a>.
          </label>
        </div>

        <button type="submit" class="btn btn-primary mt-10 w-full justify-between md:w-auto md:min-w-64">
          Enviar consulta <span aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </div>
</section>
