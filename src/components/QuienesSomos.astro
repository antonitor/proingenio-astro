---
import SectionHeader from "@/components/SectionHeader.astro";
import { cifras } from "@/data/site";

const principios = [
  {
    titulo: "Conocimiento local",
    texto: "Normativa municipal e insular de Ibiza y trato directo con las administraciones que tramitan cada expediente.",
  },
  {
    titulo: "Un solo interlocutor",
    texto: "El mismo técnico acompaña el proyecto desde el primer estudio hasta el certificado final de obra.",
  },
  {
    titulo: "Rigor técnico",
    texto: "Cálculo, documentación y cumplimiento del CTE, REBT, RITE y la normativa sectorial de aplicación.",
  },
  {
    titulo: "Ejecución acompañada",
    texto: "Dirección de obra y apoyo técnico a los instaladores para que lo proyectado se ejecute correctamente.",
  },
];
---

<section id="estudio" class="py-24 md:py-36">
  <div class="wrap">
    <SectionHeader
      numero="01"
      etiqueta="Quiénes somos"
      titulo="Conocemos la isla, su normativa y a quienes la construyen."
    />

    <!-- Texto en dos columnas, desplazado -->
    <div class="grid-12 mt-14 gap-y-6 text-ink-soft md:mt-20">
      <p class="col-span-4 md:col-span-4 md:col-start-4" data-reveal>
        PROINGENIO es una oficina técnica de ingeniería con sede en Santa Eulària des Riu. Diseñamos, coordinamos y
        legalizamos proyectos de instalaciones, infraestructuras y actividades para particulares, empresas y promotores.
      </p>
      <p class="col-span-4 md:col-span-4 md:col-start-8" data-reveal style="--reveal-delay: 100ms">
        Trabajamos con un equipo reducido y multidisciplinar, lo que nos permite conocer cada expediente en detalle y
        acompañar al cliente en todas sus fases, desde la consulta inicial hasta la puesta en marcha.
      </p>
    </div>

    <!-- Principios: lista numerada con líneas finas -->
    <ol class="mt-20 grid gap-x-6 md:mt-28 md:grid-cols-2 lg:grid-cols-4">
      {
        principios.map((p, i) => (
          <li class="border-t border-ink pb-10 pt-6" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="label text-accent">01.{i + 1}</span>
            <h3 class="mt-6 text-xl font-semibold">{p.titulo}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">{p.texto}</p>
          </li>
        ))
      }
    </ol>

    <!-- Cifras -->
    <dl class="mt-12 grid grid-cols-2 gap-2 md:mt-16 md:gap-3 lg:grid-cols-4">
      {
        cifras.map((c, i) => (
          <div
            class="flex min-h-40 flex-col-reverse justify-between gap-6 border-t-2 border-accent bg-lime p-5 md:min-h-48 md:p-8"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <dt class="label text-ink-soft">{c.etiqueta}</dt>
            <dd class="font-display text-4xl font-semibold tracking-tight text-accent sm:text-5xl md:text-6xl">
              <span class="cifra" data-target={c.valor}>{c.valor}</span><span class="text-accent-bright">{c.sufijo}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  // Contador al entrar en pantalla. El HTML trae el valor final: sin JS o con
  // movimiento reducido se ve el número correcto.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          observer.unobserve(el);
          const target = Number(el.dataset.target ?? 0);
          const inicio = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - inicio) / 1400, 1);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 4))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 }
    );
    document.querySelectorAll<HTMLElement>(".cifra").forEach((c) => observer.observe(c));
  }
</script>
