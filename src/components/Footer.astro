---
import { empresa, departamentos } from "@/data/site";
const { cta = true } = Astro.props as { cta?: boolean };
const año = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <div class="wrap pb-10 pt-20 md:pt-28">
    <!-- Cierre editorial -->
    {cta && (
    <div class="grid-12 gap-y-10 border-b border-line-dark pb-16 md:pb-20">
      <p class="label col-span-4 text-white/50 md:col-span-3">{empresa.descriptor}</p>
      <div class="col-span-4 md:col-span-9">
        <p class="display-lg max-w-[18ch]">¿Tienes un proyecto en Ibiza? Hablemos de los detalles.</p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/#contacto" class="btn btn-light">Escríbenos <span aria-hidden="true">→</span></a>
          <a href={empresa.telefonos[0].href} class="btn border border-white/30 hover:border-white">
            {empresa.telefonos[0].numero}
          </a>
        </div>
      </div>
    </div>
    )}

    <!-- Índice -->
    <div class:list={["grid-12 gap-y-12 pb-16 text-sm", cta && "pt-16"]}>
      <div class="col-span-4 md:col-span-3">
        <p class="font-display text-2xl font-semibold tracking-tight">PROINGENIO</p>
        <p class="label mt-3 text-white/50">{empresa.coordenadas}</p>
      </div>

      <div class="col-span-2 md:col-span-3">
        <p class="label mb-5 text-white/50">Departamentos</p>
        <ul class="space-y-3">
          {
            departamentos.map((d) => (
              <li>
                <a href={`/departamentos#${d.id}`} class="text-white/80 transition-colors hover:text-white">
                  {d.tituloCorto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col-span-2 md:col-span-3">
        <p class="label mb-5 text-white/50">Contacto</p>
        <ul class="space-y-3 text-white/80">
          {
            empresa.emails.map((e) => (
              <li>
                <a href={`mailto:${e}`} class="break-all transition-colors hover:text-white">{e}</a>
              </li>
            ))
          }
          {
            empresa.telefonos.map((t) => (
              <li>
                <span class="text-white/50">{t.label}</span>{" "}
                <a href={t.href} class="whitespace-nowrap transition-colors hover:text-white">{t.numero}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col-span-4 md:col-span-3">
        <p class="label mb-5 text-white/50">Oficina</p>
        <address class="not-italic leading-relaxed text-white/80">
          {empresa.direccion.map((l) => <span class="block">{l}</span>)}
        </address>
        <p class="mt-3 text-white/50">{empresa.horario}</p>
      </div>
    </div>

    <!-- Legal -->
    <div class="label flex flex-col gap-4 border-t border-line-dark pt-8 text-white/50 md:flex-row md:items-center md:justify-between">
      <p>© {año} Proingenio</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-2">
        <li><a href="/aviso-legal" class="hover:text-white">Aviso legal</a></li>
        <li><a href="/privacidad" class="hover:text-white">Privacidad</a></li>
      </ul>
    </div>
  </div>
</footer>
