---
import Layout from "@/layouts/Layout.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} | Proingenio`} description={description}>
  <section class="py-16 bg-white">
    <article class="legal container mx-auto px-4 max-w-3xl text-slate-700">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-2">{title}</h1>
      <p class="text-sm text-slate-500 mb-10">Última actualización: {updated}</p>
      <slot />
    </article>
  </section>
</Layout>

<style is:global>
  .legal h2 {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 2.25rem 0 0.75rem;
    color: var(--color-slate-900);
  }
  .legal p,
  .legal ul {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .legal li {
    margin-bottom: 0.35rem;
  }
  .legal a {
    color: var(--color-indigo-600);
    text-decoration: underline;
  }
  .legal table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .legal th,
  .legal td {
    border: 1px solid var(--color-slate-300);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  /* Datos pendientes de completar por la empresa: se ven resaltados a propósito */
  .legal .pendiente {
    background: #fef08a;
    color: #713f12;
    padding: 0 0.25rem;
    border-radius: 0.25rem;
    font-weight: 600;
  }
</style>
