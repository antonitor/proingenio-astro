---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} · Proingenio`} description={description}>
  <PageHeader ruta={title} titulo={title} />
  <section class="wrap py-20 md:py-28">
    <div class="grid-12 gap-y-10">
      <aside class="col-span-4 md:col-span-3">
        <p class="label text-ink-mute">Última actualización</p>
        <p class="label mt-2">{updated}</p>
      </aside>
      <article class="legal col-span-4 max-w-[68ch] text-ink-soft md:col-span-8">
        <slot />
      </article>
    </div>
  </section>
</Layout>

<style is:global>
  .legal h2 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 3rem 0 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .legal h2:first-child {
    margin-top: 0;
  }
  .legal p,
  .legal ul {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .legal ul {
    list-style: none;
    padding-left: 0;
  }
  .legal li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.4rem;
  }
  .legal li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
  .legal a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal a:hover {
    color: var(--color-accent);
  }
  .legal strong {
    color: var(--color-ink);
  }
  .legal table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }
  .legal th {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }
  .legal th,
  .legal td {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 0.75rem 1rem 0.75rem 0;
    text-align: left;
    vertical-align: top;
  }
  /* Datos pendientes de completar por la empresa: se ven resaltados a propósito */
  .legal .pendiente {
    background: #fef08a;
    color: #713f12;
    padding: 0 0.25rem;
    font-weight: 600;
  }
</style>
