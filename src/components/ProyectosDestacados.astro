---
import { Image } from "astro:assets";
import SectionHeader from "@/components/SectionHeader.astro";
import { proyectos } from "@/data/site";

// Composición asimétrica: cada proyecto ocupa una posición distinta en la retícula
const layout = [
  { col: "md:col-span-8", aspect: "aspect-[4/3] md:aspect-[16/10]", ancho: 1100, extra: "" },
  { col: "md:col-span-4", aspect: "aspect-[4/3] md:aspect-[4/5]", ancho: 640, extra: "md:mt-40" },
  { col: "md:col-span-5 md:col-start-2", aspect: "aspect-[4/3] md:aspect-[4/5]", ancho: 720, extra: "" },
  { col: "md:col-span-6 md:col-start-7", aspect: "aspect-[4/3]", ancho: 900, extra: "md:mt-48" },
];
---

<section id="proyectos" class="py-24 md:py-36">
  <div class="wrap">
    <SectionHeader
      numero="03"
      etiqueta="Proyectos"
      titulo="Trabajo reciente."
      intro="Una selección de encargos de distinta escala: desde la licencia de un local hasta las redes de una urbanización."
    />

    <div class="grid-12 mt-16 gap-y-16 md:mt-24 md:gap-y-24">
      {
        proyectos.map((p, i) => {
          const l = layout[i % layout.length];
          return (
            <article class:list={["group col-span-4", l.col, l.extra]} data-reveal style={`--reveal-delay: ${(i % 2) * 120}ms`}>
              <div class="overflow-hidden">
                <Image
                  src={p.imagen}
                  width={l.ancho}
                  quality={78}
                  alt={p.alt}
                  class:list={["photo w-full object-cover group-hover:scale-[1.03]", l.aspect]}
                />
              </div>
              <div class="mt-5 grid grid-cols-[auto_1fr] gap-x-5 border-t border-line pt-5">
                <span class="label text-accent">P-{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <p class="label text-ink-mute">
                    {p.tipo} · {p.lugar} · {p.año}
                  </p>
                  <h3 class="mt-3 text-xl font-semibold tracking-tight md:text-2xl">{p.titulo}</h3>
                  <p class="mt-2 text-[0.9375rem] text-ink-soft">{p.alcance}</p>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
