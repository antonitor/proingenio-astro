---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
---

<Layout title="Mensaje enviado · Proingenio" noindex>
  <PageHeader
    ruta="Mensaje enviado"
    titulo="Gracias, hemos recibido tu consulta."
    intro="La revisaremos y te responderemos personalmente, normalmente en uno o dos días laborables."
  >
    <div class="mt-12 flex flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms">
      <a href="/" class="btn btn-primary">Volver al inicio <span aria-hidden="true">→</span></a>
      <a href="/departamentos" class="btn btn-ghost">Ver departamentos</a>
    </div>
  </PageHeader>
</Layout>
