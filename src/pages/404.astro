---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
---

<Layout title="Página no encontrada · Proingenio" noindex>
  <PageHeader
    ruta="Error 404"
    titulo="Esta página no está en el plano."
    intro="La dirección que buscas no existe o se ha movido."
  >
    <div class="mt-12 flex flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms">
      <a href="/" class="btn btn-primary">Ir al inicio <span aria-hidden="true">→</span></a>
      <a href="/#contacto" class="btn btn-ghost">Contactar</a>
    </div>
  </PageHeader>
</Layout>
