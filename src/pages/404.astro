---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Página no encontrada | Proingenio" noindex>
  <section class="py-24 bg-white">
    <div class="container mx-auto px-4 max-w-xl text-center">
      <p class="text-6xl font-bold text-indigo-600 mb-4">404</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
        Página no encontrada
      </h1>
      <p class="text-lg text-slate-600 mb-8">
        La página que buscas no existe o se ha movido.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/" class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-6 py-3 font-medium text-white hover:bg-indigo-700">Ir al inicio</a>
        <a href="/#contacto" class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 font-medium text-slate-900 hover:bg-slate-50">Contactar</a>
      </div>
    </div>
  </section>
</Layout>
