---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { departamentos } from "@/data/site";

// Página provisional: cuando haya proyectos reales, se puede reutilizar
// src/components/ProyectosDestacados.astro con los datos de src/data/site.ts.
---

<Layout
  title="Proyectos · Proingenio"
  description="Selección de proyectos de Proingenio, oficina técnica de ingeniería en Ibiza. Página en preparación."
  noindex
>
  <PageHeader
    ruta="Proyectos"
    titulo="Proyectos."
    intro="Estamos preparando una selección de nuestros trabajos. Mientras tanto, puedes conocer nuestras áreas de trabajo o escribirnos para hablar de tu proyecto."
  >
    <p class="label mt-10 inline-flex items-center gap-3 border border-ink px-3 py-2" data-reveal style="--reveal-delay: 200ms">
      <span class="h-2 w-2 animate-pulse bg-accent" aria-hidden="true"></span>
      En construcción
    </p>
    <div class="mt-12 flex flex-wrap gap-4" data-reveal style="--reveal-delay: 260ms">
      <a href="/departamentos" class="btn btn-primary">Ver departamentos <span aria-hidden="true">→</span></a>
      <a href="/#contacto" class="btn btn-ghost">Contactar</a>
    </div>
  </PageHeader>

  <!-- Áreas de trabajo, para que la página no quede vacía -->
  <section class="wrap py-20 md:py-28">
    <div class="grid-12 gap-y-10">
      <p class="label col-span-4 text-ink-mute md:col-span-3">Áreas de trabajo</p>
      <ul class="col-span-4 border-b border-line md:col-span-9">
        {
          departamentos.map((d) => (
            <li class="border-t border-line">
              <a href={`/departamentos#${d.id}`} class="group flex items-baseline gap-6 py-5">
                <span class="label text-accent">{d.codigo}</span>
                <span class="flex-1 text-lg font-medium transition-colors group-hover:text-accent">{d.titulo}</span>
                <span class="text-ink-mute transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
