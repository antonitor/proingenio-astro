---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { departamentos } from "@/data/site";
---

<Layout
  title="Departamentos · Proingenio"
  description="Proyectos de instalaciones interiores, infraestructuras y actividades, y asesoramiento a instaladores en Ibiza."
>
  <PageHeader
    ruta="Departamentos"
    titulo="Áreas de trabajo."
    intro="Proyecto, tramitación y dirección de obra en cuatro especialidades. Un mismo equipo coordina todas las disciplinas que intervienen en cada encargo."
  >
    <!-- Índice de departamentos -->
    <nav class="mt-14" aria-label="Departamentos">
      <ol class="grid gap-x-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          departamentos.map((d, i) => (
            <li data-reveal style={`--reveal-delay: ${200 + i * 60}ms`}>
              <a href={`#${d.id}`} class="group flex h-full flex-col gap-3 border-t border-ink py-4 transition-colors hover:border-accent">
                <span class="label text-accent">{d.codigo}</span>
                <span class="font-medium leading-snug group-hover:text-accent">{d.tituloCorto}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </PageHeader>

  {
    departamentos.map((d, i) => (
      <section id={d.id} class:list={["py-24 md:py-32", i % 2 === 1 && "bg-lime"]}>
        <div class="wrap grid-12 gap-y-10">
          <!-- Columna de índice fija -->
          <div class="col-span-4 md:col-span-3">
            <div class="md:sticky md:top-28">
              <p class="font-display text-7xl font-semibold leading-none tracking-tighter text-accent md:text-8xl" data-reveal>
                {d.codigo}
              </p>
              <p class="label mt-4 text-ink-mute" data-reveal style="--reveal-delay: 80ms">
                Departamento {d.codigo} / 04
              </p>
            </div>
          </div>

          <div class="col-span-4 md:col-span-9">
            <h2 class="display-lg max-w-[18ch]" data-reveal>{d.titulo}</h2>

            <figure class="mt-12 md:mt-16">
              <div class="crop-marks">
                <div class="overflow-hidden" data-reveal="image">
                  <Image
                    src={d.imagen}
                    width={1100}
                    quality={d.id === "infraestructuras" ? 70 : 78}
                    alt={d.alt}
                    class="photo aspect-[4/3] w-full object-cover md:aspect-[16/9]"
                  />
                </div>
              </div>
              <figcaption class="label mt-4 text-ink-mute">Fig. {d.codigo} — {d.tituloCorto}</figcaption>
            </figure>

            <div class="mt-12 grid gap-10 md:mt-16 lg:grid-cols-9 lg:gap-6">
              <p class="lead text-ink-soft lg:col-span-4" data-reveal>{d.descripcion}</p>
              <div class="lg:col-span-4 lg:col-start-6">
                <p class="label mb-4 text-ink-mute" data-reveal>Alcance</p>
                <ul class="border-b border-line">
                  {d.servicios.map((s, j) => (
                    <li class="flex gap-5 border-t border-line py-3.5" data-reveal style={`--reveal-delay: ${j * 50}ms`}>
                      <span class="label pt-1 text-accent">{d.codigo}.{j + 1}</span>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
                <a href="/#contacto" class="arrow-link mt-8" data-reveal>
                  Consultar un proyecto <span class="arrow" aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }
</Layout>
